  "observations": [
    {
      "kind": "fixture",
      "text": "A disposable namespaced user with one onboarded place; creates, renames, default changes and deletes are real writes. Only the named equipment read, default change and viability refusal are answered locally for that user."
    },
    {
      "kind": "contract",
      "text": "Saving a nameless place is refused before any write: the Name field is marked invalid and takes focus."
    },
    {
      "kind": "contract",
      "text": "Create then rename are real save_location writes: after a full reload the renamed place is listed and stored once."
    },
    {
      "kind": "keyboard",
      "text": "The delete confirmation is a native dialog: focus is held inside it while open and Escape dismisses it without deleting."
    },
    {
      "kind": "contract",
      "text": "The default cannot be deleted until another place is made default; a failed default change rolls back; the confirmed delete removes the stored row and survives reload."
    }
  ],
