  "observations": [
    {
      "kind": "fixture",
      "text": "A disposable namespaced user; the first experience PATCH is held then answered with the typed settings_not_viable refusal, every later write is the real endpoint."
    },
    {
      "kind": "contract",
      "text": "Settings is five landmark sections, each a current card with a 12px bar and its heading inside: Training, Limitations, Appearance, Places and equipment, Session.",
      "data": [
        {
          "level": 1,
          "text": "Settings"
        },
        {
          "level": 2,
          "text": "Training"
        },
        {
          "level": 2,
          "text": "Limitations"
        },
        {
          "level": 2,
          "text": "Appearance"
        },
        {
          "level": 2,
          "text": "Places and equipment"
        },
        {
          "level": 2,
          "text": "Session"
        }
      ]
    },
    {
      "kind": "contract",
      "text": "A typed settings_not_viable refusal rolls the control back to the stored value and says so; the stored profile still reads experience_level=some."
    },
    {
      "kind": "contract",
      "text": "After a full reload the saved Confident experience and the Hard conditioning limitation are still selected, and the stored profile reads experience_level=confident."
    },
    {
      "kind": "contract",
      "text": "Choosing a skin writes clear.skin and data-skin through the picker; the stored key is what boot applies on reload (the same path every capture here uses to pin its skin)."
    },
    {
      "kind": "keyboard",
      "text": "The Goal radiogroup is reached by Tab and framed by the static bracket layer.",
      "data": {
        "mode": "brackets",
        "tag": "button",
        "role": "radio",
        "name": "Balanced",
        "layers": 1,
        "bracketOpacity": 1
      }
    },
    {
      "kind": "keyboard",
      "text": "The limitations note owns its focus: the bracket layer stays hidden on a text field.",
      "data": {
        "mode": "brackets",
        "tag": "textarea",
        "role": null,
        "name": "",
        "layers": 1,
        "bracketOpacity": 0
      }
    }
  ],
