  "observations": [
    {
      "kind": "fixture",
      "text": "A persisted seven-structure prescription started through start_session; the clock is Playwright's, advanced and paused so urgency and timing are observed at exact points."
    },
    {
      "kind": "containment",
      "text": "Standard: shell, section, block and set form are sibling cards; fields and labels inside; Session time is a labelled non-live timer card.",
      "data": {
        "cards": 3,
        "nested": 0,
        "fieldsOutsideCards": [],
        "radius": 0
      }
    },
    {
      "kind": "timer",
      "text": "Paused at two clock points six seconds apart, Session time advanced by six and the rest counted down by six: one wall clock drives both.",
      "data": {
        "before": {
          "session": 17,
          "rest": 15
        },
        "after": {
          "session": 23,
          "rest": 9
        }
      }
    },
    {
      "kind": "timer",
      "text": "Rest low state: the card takes the timer-low role, digits cross colour over 0.4s in four steps, the card dims to 80% on the 4s two-step pulse, and no glow is added to the timer.",
      "data": {
        "name": "Time remaining",
        "role": "timer",
        "live": null,
        "cardDepth": 1,
        "digits": "00:09",
        "crossing": {
          "duration": "0.4s",
          "timing": "steps(4)"
        },
        "digitGlow": {
          "own": "0px 0px 2px, 0px 0px 6px",
          "body": "0px 0px 2px, 0px 0px 6px",
          "inline": null
        },
        "low": true,
        "pulse": {
          "animation": "clr-micro-pulse",
          "duration": "4s",
          "timing": "steps(2)",
          "minimumOpacity": 0.8,
          "running": "running",
          "boxShadow": "none"
        }
      }
    },
    {
      "kind": "motion",
      "text": "Coaching loading beside an urgent rest: the rest pulse holds the one interface loop and the loading region is stilled but still busy.",
      "data": {
        "running": [
          "Rest"
        ],
        "stilled": 3
      }
    },
    {
      "kind": "containment",
      "text": "Coaching: cues, regression and the note field are ruled sub-groups with their labels inside one card, never a card in a card.",
      "data": {
        "sameCard": true,
        "regressionInSameCard": true,
        "noteInSameCard": true
      }
    },
    {
      "kind": "timer",
      "text": "EMOM low state: the shipped TimerDisplay is its own card beside the block card, steps its colour over 0.4s and pulses to 80% on the one loop, with no extra glow.",
      "data": {
        "name": "Time remaining",
        "role": "timer",
        "live": null,
        "cardDepth": 1,
        "digits": "00:08",
        "crossing": {
          "duration": "0.4s",
          "timing": "steps(4)"
        },
        "digitGlow": {
          "own": "0px 0px 2px, 0px 0px 6px",
          "body": "0px 0px 2px, 0px 0px 6px",
          "inline": null
        },
        "low": true,
        "pulse": {
          "animation": "clr-micro-pulse",
          "duration": "4s",
          "timing": "steps(2)",
          "minimumOpacity": 0.8,
          "running": "running",
          "boxShadow": "none"
        }
      }
    },
    {
      "kind": "containment",
      "text": "Finish workout stays inside the 390x320 short viewport on the last section (TASK-040's recorded overflow condition, now executed)."
    },
    {
      "kind": "contract",
      "text": "A failed completion keeps the session active behind its dialog; Finish again completes the stored session and lands on Summary."
    }
  ],
