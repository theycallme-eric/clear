  "observations": [
    {
      "kind": "fixture",
      "text": "A completed persisted fixture with one weighted working set; anchors are the app's own deriveAnchors over the real anchor_evidence read, stored through set_load_anchors. Review is reached through History Restart, not a sample screen."
    },
    {
      "kind": "containment",
      "text": "Review: overview metrics and seven section cards, no card nested in another, every field and label inside its card, Start and Regenerate pinned in the footer.",
      "data": {
        "cards": 8,
        "nested": 0,
        "fieldsOutsideCards": [],
        "radius": 0
      }
    },
    {
      "kind": "keyboard",
      "text": "The load suggestion is the public TextAction: a real button with the chevron, a 40px target, reached by Tab with keyboard focus and opening its dialog on Enter.",
      "data": {
        "action": {
          "tag": "button",
          "type": "button",
          "chevron": "\"›\"",
          "height": 40,
          "framed": true,
          "name": "Suggested 90 lb · +1.82 lb · Low confidence · 1 session",
          "popup": "dialog"
        },
        "focused": {
          "tag": "button",
          "className": "clr-text-action",
          "name": "Suggested 90 lb · +1.82 lb · Low confidence · 1 session",
          "focusVisible": true,
          "brackets": 1,
          "height": 40
        }
      }
    },
    {
      "kind": "contract",
      "text": "A failed Start leaves the briefing in place behind its blocking dialog, with Start offered again; no session was started."
    },
    {
      "kind": "contract",
      "text": "Regenerate asks first; confirming discards the briefing and runs a generation (held locally, never forwarded); Cancel returns to Review with nothing to review rather than the discarded workout."
    },
    {
      "kind": "contract",
      "text": "Start persists and starts the restarted session and lands on /workout with the first set form."
    }
  ],
