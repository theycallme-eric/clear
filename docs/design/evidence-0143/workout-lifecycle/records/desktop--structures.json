  "observations": [
    {
      "kind": "fixture",
      "text": "A persisted seven-structure prescription started through start_session; the clock is Playwright's, advanced and paused so urgency and timing are observed at exact points."
    },
    {
      "kind": "containment",
      "text": "Standard: shell, section, block and set form are sibling cards; fields and labels inside; Session time is a labelled non-live timer card.",
      "data": {
        "cards": 3,
        "nested": 0,
        "fieldsOutsideCards": [],
        "radius": 0
      }
    },
    {
      "kind": "timer",
      "text": "Paused at two clock points six seconds apart, Session time advanced by six and the rest counted down by six: one wall clock drives both.",
      "data": {
        "before": {
          "session": 18,
          "rest": 15
        },
        "after": {
          "session": 24,
          "rest": 9
        }
      }
