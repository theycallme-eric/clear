{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/AppHeader/**",
              "components/Button/**",
              "components/ChamferedFrame/**",
              "components/Chip/**",
              "components/ChoiceGroup/**",
              "components/Dialog/**",
              "components/EmptyState/**",
              "components/FormField/**",
              "components/Input/**",
              "components/Progress/**",
              "components/ScanLoader/**",
              "components/Selection/**",
              "components/Slider/**",
              "components/TabBar/**",
              "components/TimerDisplay/**",
              "components/Toast/**",
              "index.js",
              "skin.js",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Oxanium|Rajdhani|Space Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Oxanium, Rajdhani, Space Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:meta|actions|children|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: meta, actions, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|loading|disabled|icon|iconOnly|buttonRef|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, loading, disabled, icon, iconOnly, buttonRef."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|quiet|critical)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'quiet' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChamferedFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:cornerSize|surfaceColor|borderColor|borderWidth|hasLeftBorder|bottomBorderOnly|scan|trace|glow|children|key|ref|className|style|children)$/]",
        "message": "<ChamferedFrame> doesn't accept that prop. Declared props: cornerSize, surfaceColor, borderColor, borderWidth, hasLeftBorder, bottomBorderOnly, scan, trace, glow, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|indeterminate|disabled|required|onChange|label|inputRef|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, defaultChecked, indeterminate, disabled, required, onChange, label, inputRef."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChoiceOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|disabled|key|ref|className|style|children)$/]",
        "message": "<ChoiceOption> doesn't accept that prop. Declared props: value, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|actions|critical|dismissOnBackdrop|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, onClose, title, actions, critical, dismissOnBackdrop."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|message|actionLabel|onAction|icon|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, message, actionLabel, onAction, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FormFieldRenderArgs'] > JSXAttribute > JSXIdentifier[name!=/^(?:describedBy|invalid|key|ref|className|style|children)$/]",
        "message": "<FormFieldRenderArgs> doesn't accept that prop. Declared props: describedBy, invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|defaultValue|onChange|placeholder|multiline|rows|disabled|readOnly|required|invalid|helperText|errorText|inputRef|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, value, defaultValue, onChange, placeholder, multiline, rows, disabled, readOnly, required, invalid, helperText, errorText, inputRef."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntensitySlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|defaultValue|min|max|step|onChange|label|valueText|disabled|inputRef|key|ref|className|style|children)$/]",
        "message": "<IntensitySlider> doesn't accept that prop. Declared props: value, defaultValue, min, max, step, onChange, label, valueText, disabled, inputRef."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|label|showValue|segments|key|ref|className|style|children)$/]",
        "message": "<Progress> doesn't accept that prop. Declared props: value, max, label, showValue, segments."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadioButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|defaultChecked|disabled|required|onChange|label|name|inputRef|key|ref|className|style|children)$/]",
        "message": "<RadioButton> doesn't accept that prop. Declared props: checked, defaultChecked, disabled, required, onChange, label, name, inputRef."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScanLoader'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|lines|value|max|status|key|ref|className|style|children)$/]",
        "message": "<ScanLoader> doesn't accept that prop. Declared props: label, lines, value, max, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScanLoader'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:ok|slow|failed)$/]",
        "message": "<ScanLoader> status must be one of 'ok' | 'slow' | 'failed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|disabled|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimerDisplay'] > JSXAttribute > JSXIdentifier[name!=/^(?:seconds|lowThreshold|size|style|key|ref|className|style|children)$/]",
        "message": "<TimerDisplay> doesn't accept that prop. Declared props: seconds, lowThreshold, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimerDisplay'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<TimerDisplay> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|actionLabel|onAction|onDismiss|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: children, variant, actionLabel, onAction, onDismiss."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:info|positive|negative)$/]",
        "message": "<Toast> variant must be one of 'info' | 'positive' | 'negative'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
